    writeStep = -1;
};

// We don't #include the Collation layer because we need to use syncLayer to keep the
// random selection in sync between the two layers, and the syncLayer causes many
// parameters to be copied from the synched layer.
ImageLayer "Combined_random" = {
    nxScale = 1;
    nyScale = 1;
    nf = 3;
    phase = 0;
    mirrorBCflag = false;
    valueBC = 0.0;
    syncLayer = "Collation_random";

    inputPath = "input/CombinedImages.txt";
    offsetAnchor = "tl";
    offsetX = 0;
    offsetY = 0;
    autoResizeFlag = false;
    inverseFlag = false; 
    normalizeLuminanceFlag = false;
    useInputBCflag = false;
    padValue = 0.0;
    updateGpu = false;
    sparseLayer = false;
    writeStep = -1;
};

HyPerLayer "Comparison_random" = {
    nxScale = 1; 
    nyScale = 1;
    nf = 3;
    phase = 1;
    mirrorBCflag = true;
    triggerLayerName = NULL;
    InitVType = "ZeroV";
    updateGpu = false;
    sparseLayer = false;
    writeStep = 1.0;
    initialWriteTime = 0.0;

};

IdentConn "Collation_randomToComparison_random" = {
    preLayerName = "Collation_random";
    postLayerName = "Comparison_random";
    channelCode = 0;
    delay = 0;
};

IdentConn "Combined_randomToComparison_random" = {
    preLayerName = "Combined_random";
