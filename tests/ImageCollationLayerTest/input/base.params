//
// base.params
//
//  A params file to test ImageCollationLayer.
//  There are several subtests that test different parameter settings.
//  The basic idea behind each is as follows:
//    An ImageCollationLayer reads grayscale image files into a 32x32x3 layer,
//    combining three grayscale images into a single RGB layer.
//    An ImageLayer reads color image files into a 32x32x3 layer, reading the
//    file as is. The files that the ImageCollationLayer reads combine into the
//    files that ImageLayer reads, so that the two layers should contain the
//    same values. A RequireAllZeroActivityProbe checks this.
//

debugParsing = false;

HyPerCol "column" = {
   dt = 1.0;
   stopTime = 30.0;  
   progressInterval = 30.0;
   writeProgressToErr = false;
   printParamsFilename = "base.params";
   randomSeed = 3724297235;
   nx = 32;
   ny = 32;
   nbatch = 2;
   errorOnNotANumber = true;
   outputPath = "output/base";
   verifyWrites = false;
   checkpointWrite = false;
   lastCheckpointDir = "output/base/Last";
   initializeFromCheckpointDir = "";
};

//
// Test batchMethod = "byFile"
//

ImageCollationLayer "Collation_byFile" = {
    nxScale = 1;
    nyScale = 1;
    nf = 3;
    phase = 0;
    mirrorBCflag = false;
    valueBC = 0.0;

    displayPeriod = 5;

    inputPath = "input/SeparatedImages.txt";
    offsetAnchor = "tl";
    offsetX = 0;
    offsetY = 0;
    autoResizeFlag = false;
    inverseFlag = false; 
    normalizeLuminanceFlag = false;
    useInputBCflag = false;
    padValue = 0.0;
    batchMethod = "byFile";
    updateGpu = false;
    sparseLayer = false;
    writeStep = -1;
};

ImageLayer "Combined_byFile" = {
    #include "Collation_byFile";
    @inputPath = "input/CombinedImages.txt";
};

HyPerLayer "Comparison_byFile" = {
    nxScale = 1; 
    nyScale = 1;
    nf = 3;
    phase = 1;
    mirrorBCflag = true;
    triggerLayerName = NULL;
    InitVType = "ZeroV";
    updateGpu = false;
    sparseLayer = false;
    writeStep = 1.0;
    initialWriteTime = 0.0;

};

IdentConn "Collation_byFileToComparison_byFile" = {
    preLayerName = "Collation_byFile";
    postLayerName = "Comparison_byFile";
    channelCode = 0;
    delay = 0;
};

IdentConn "Combined_byFileToComparison_byFile" = {
    preLayerName = "Combined_byFile";
    postLayerName = "Comparison_byFile";
    channelCode = 1;
    delay = 0;
};

RequireAllZeroActivityProbe "CheckEqual_byFile" = {
    targetLayer = "Comparison_byFile";
    textOutputFlag = true;
    probeOutputFile = NULL;
    message = NULL;
    triggerLayerName = NULL;
    nnzThreshold = 1.0e-8;
    exitOnFailure = true;
    immediateExitOnFailure = true;
};

