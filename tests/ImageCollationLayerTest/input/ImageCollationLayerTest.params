//
// ImageCollationLayerTest.params
//
//  A params file to test ImageCollationLayer.
//  An ImageCollationLayer reads grayscale image files into a 32x32x3 layer,
//  combining three grayscale images into a single RGB layer.
//  In ImageLayer reads color image files into a 32x32x3 layer, reading the
//  file as is. The files the the ImageCollationLayer reads combine into the
//  files that ImageLayer reads, so that the two layers should contain the
//  same values. A RequireAllZeroActivityProbe checks this.
//

debugParsing = false;

HyPerCol "column" = {
   dt = 1.0;
   stopTime = 30.0;  
   progressInterval = 30.0;
   writeProgressToErr = false;
   printParamsFilename = "ImageCollationLayerTest.params";
   randomSeed = 1234567890;
   nx = 32;
   ny = 32;
   nbatch = 2;
   errorOnNotANumber = true;
   outputPath = "output/";
   verifyWrites = false;
   checkpointWrite = false;
   lastCheckpointDir = "output/Last";
   initializeFromCheckpointDir = "";
};

//
// layers
//

ImageCollationLayer "Collation" = {
    nxScale = 1;
    nyScale = 1;
    nf = 3;
    phase = 0;
    mirrorBCflag = false;
    valueBC = 0.0;
    	      	
    displayPeriod = 5;

    inputPath = "input/SeparatedImages.txt";
    offsetAnchor = "tl";
    offsetX = 0;
    offsetY = 0;
    autoResizeFlag = false;
    inverseFlag = false; 
    normalizeLuminanceFlag = false;
    useInputBCflag = false;
    padValue = 0.0;
    batchMethod = "byFile";
    updateGpu = false;
    sparseLayer = false;
    writeStep = -1;
};

ImageLayer "Combined" = {
    nxScale = 1;
    nyScale = 1;
    nf = 3;
    phase = 0;
    mirrorBCflag = false;
    valueBC = 0.0;
    	      	
    displayPeriod = 5;

    inputPath = "input/CombinedImages.txt";
    offsetAnchor = "tl";
    offsetX = 0;
    offsetY = 0;
    autoResizeFlag = false;
    inverseFlag = false; 
    normalizeLuminanceFlag = false;
    useInputBCflag = false;
    padValue = 0.0;
    batchMethod = "byFile";
    updateGpu = false;
    sparseLayer = false;
    writeStep = -1;
};

HyPerLayer "Comparison" = {
    nxScale = 1; 
    nyScale = 1;
    nf = 3;
    phase = 1;
    mirrorBCflag = true;
    triggerLayerName = NULL;
    InitVType = "ZeroV";
    updateGpu = false;
    sparseLayer = false;
    writeStep = 1.0;
    initialWriteTime = 0.0;

};

//
// connections
//

IdentConn "CollationToComparison" = {
    preLayerName = "Collation";
    postLayerName = "Comparison";
    channelCode = 0;
    delay = 0;
};

IdentConn "CombinedToComparison" = {
    preLayerName = "Combined";
    postLayerName = "Comparison";
    channelCode = 1;
    delay = 0;
};

//
// probe
//

RequireAllZeroActivityProbe "CheckEqual" = {
    targetLayer = "Comparison";
    textOutputFlag = true;
    probeOutputFile = NULL;
    message = NULL;
    triggerLayerName = NULL;
    nnzThreshold = 0;
    exitOnFailure = true;
    immediateExitOnFailure = true;
};
