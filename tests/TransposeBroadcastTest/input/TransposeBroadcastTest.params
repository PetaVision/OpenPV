};

RequireAllZeroActivityProbe "CheckEqual_normalizeLuminance" = {
    targetLayer = "CompareBAndC";
    textOutputFlag = true;
    probeOutputFile = NULL;
    message = NULL;
    triggerLayerName = NULL;
    nnzThreshold = 1.0e-1; // B and C should have values of approx. 3072; this is a relative error of ~ 0.0003%.
    exitOnFailure = false;
    immediateExitOnFailure = false;
};
