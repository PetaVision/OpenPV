HyPerLayer "CompareBAndC" = {
    broadcastFlag                       = true;
    nf                                  = 4096;
    phase                               = 2;
    writeStep                           = 1;
    initialWriteTime                    = 0;
    // sparseLayer;
    mirrorBCflag                        = false;
    valueBC                             = 0.0;
    // GPUAccelerate;
    
    InitVType                           = "ZeroV";

    triggerLayerName                    = NULL;
    sparseLayer                         = false;
};

HyPerConn "LayerAToBroadcastLayerB" = {
    preLayerName                        = "LayerA";
    postLayerName                       = "BroadcastLayerB";
    channelCode                         = 0;
    sharedWeights                       = false;
    nxp                                 = 1;
    nyp                                 = 1;
    nfp                                 = 4096;
    numAxonalArbors                     = 1;
    delay                               = 0;
    updateGSynFromPostPerspective       = false;
    plasticityFlag                      = false;
    pvpatchAccumulateType               = "convolve";
    writeStep                           = -1;
    // initialWriteTime;
    // writeCompressedWeights;
    writeCompressedCheckpoints          = false;

    weightInitType                      = "UniformRandomWeight";
    wMinInit                            = 1.0;
    wMaxInit                            = 2.0;
    sparseFraction                      = 0.0;
    
    normalizeMethod                     = "none";
};

TransposeConn "BroadcastLayerBToLayerA" = {
    preLayerName                        = "BroadcastLayerB";
    postLayerName                       = "LayerA";
    channelCode                         = -1;
    originalConnName                    = "LayerAToBroadcastLayerB";
    delay                               = 0;
    updateGSynFromPostPerspective       = false;
