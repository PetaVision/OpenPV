    // checkpointWriteStepInterval;
    // checkpointWriteTimeInterval;
    // deleteOlderCheckpoints;
    // suppressNonplasticCheckpoints;
    lastCheckpointDir                   = "output/Last";
    errorOnNotANumber                   = false;
