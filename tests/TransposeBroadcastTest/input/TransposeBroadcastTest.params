    nyScale                             = 1;
    nf                                  = 4;
    phase                               = 1;
    writeStep                           = -1;
    // initialWriteTime;
    // sparseLayer;
    mirrorBCflag                        = false;
    valueBC                             = 0.0;
    // GPUAccelerate;
    
    InitVType                           = "UniformRandomV";
    
    triggerLayerName                    = NULL;
    sparseLayer                         = false;

    VThresh                             = -infinity;
    AMin                                = -infinity;
    AShift                              = 0.0;
    AMax                                = infinity;
    VWidth                              = 0.0;
};

HyPerLayer "BroadcastLayerB" = {
    broadcastFlag                       = true;
    nf                                  = 4096;
    phase                               = 1;
    writeStep                           = -1;
    // initialWriteTime;
    // sparseLayer;
    mirrorBCflag                        = false;
    valueBC                             = 0.0;
    // GPUAccelerate;
    
    InitVType                           = "ZeroV";

    triggerLayerName                    = NULL;
    sparseLayer                         = false;
};

HyPerLayer "BroadcastLayerC" = {
    broadcastFlag                       = true;
    nf                                  = 4096;
    phase                               = 1;
    writeStep                           = -1;
    // initialWriteTime;
    // sparseLayer;
    mirrorBCflag                        = false;
    valueBC                             = 0.0;
    // GPUAccelerate;
    
    InitVType                           = "ZeroV";

