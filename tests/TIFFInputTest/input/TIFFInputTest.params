IdentConn "TIFFToComparison" = {
    preLayerName = "TIFF";
    postLayerName = "Comparison";
    channelCode = 0;
    delay = 0;
};

IdentConn "PVPCheckToComparison" = {
    preLayerName = "PVPCheck";
    postLayerName = "Comparison";
    channelCode = 1;
    delay = 0;
};

RequireAllZeroActivityProbe "ComparisonProbe" = {
    targetLayer = "Comparison";
    message = "comparison                    ";
    probeOutputFile = "Comparison.txt";
    triggerLayerName = NULL;
    nnzThreshold = 1.0e-4;
};
