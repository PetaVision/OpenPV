// A params file to test whether the Image class can read a TIFF at (8-bit precision)
//
// An ImageLayer reads the file input/PetaVisionLogo.tif, and a PVPLayer reads the file
// input/PetaVisionLogo.pvp. Pixel-per-pixel, the .pvp file is the same as the .tif file,
// except divided by 255. This is the normalization Image does, so the two layers should
// be the same. The layer "Comparison" holds the difference, and a RequireAllZeroActivityProbe
// verifies that the difference is zero, allowing a small tolerance because of the potential for
// floating-point discrepancy when dividing by 255.

debugParsing = false;

HyPerCol "column" = {
   nx = 64;
   ny = 64;
   nbatch = 1;
   dt = 1.0;
   randomSeed = 1234567890;
   stopTime = 1.0;  
   errorOnNotANumber = true;
   progressInterval = 1.0;
   writeProgressToErr = false;
   verifyWrites = false;
   outputPath = "output/";
   printParamsFilename = "TIFFInputTest.params";
   initializeFromCheckpointDir = "";
   checkpointWrite = false;
   lastCheckpointDir = "output/Last";
};

ImageLayer "TIFF" = {
    nxScale = 1;
    nyScale = 1;
    	      	
    displayPeriod = 0;

    inputPath = "input/PetaVisionLogo.tif";
    nf = 3;
    phase = 0;
    writeStep = 1.0;
    initialWriteTime = 0.0;
    sparseLayer = false;
    mirrorBCflag = false;
    valueBC = 0.0;
    useInputBCflag = false;
    updateGpu = false;
    inverseFlag = false; 
    normalizeLuminanceFlag = false;
    autoResizeFlag = false;
    offsetAnchor = "tl";
    offsetX = 0;
    offsetY = 0;
    padValue = 0.0;
};

PvpLayer "PVPCheck" = {
    nxScale = 1;
    nyScale = 1;
    	      	
    displayPeriod = 0;

    inputPath = "input/PetaVisionLogo.pvp";
    nf = 3;
    phase = 0;
    writeStep = 1.0;
    initialWriteTime = 0.0;
    sparseLayer = false;
    mirrorBCflag = false;
    valueBC = 0.0;
    useInputBCflag = false;
    updateGpu = false;
    inverseFlag = false; 
    normalizeLuminanceFlag = false;
    autoResizeFlag = false;
    offsetAnchor = "tl";
    offsetX = 0;
    offsetY = 0;
    padValue = 0.0;
};

HyPerLayer "Comparison" = {
    nxScale = 1; 
    nyScale = 1;
    nf = 3;
    phase = 1;
    triggerLayerName = NULL;
    writeStep = 1.0;
    initialWriteTime = 1.0;
    mirrorBCflag = 1;
    sparseLayer = false;
    updateGpu = false;

    InitVType = "ZeroV";
};

IdentConn "TIFFToComparison" = {
    preLayerName = "TIFF";
    postLayerName = "Comparison";
    channelCode = 0;
    delay = 0;
};

IdentConn "PVPCheckToComparison" = {
    preLayerName = "PVPCheck";
    postLayerName = "Comparison";
    channelCode = 1;
    delay = 0;
};

RequireAllZeroActivityProbe "ComparisonProbe" = {
    targetLayer = "Comparison";
    message = "comparison                    ";
    probeOutputFile = "Comparison.txt";
    triggerLayerName = NULL;
    nnzThreshold = 1.0e-4;
};
