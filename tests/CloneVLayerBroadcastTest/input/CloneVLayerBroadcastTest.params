//
// CloneVLayerBroadcastTest.params

//  A params file to test CloneVLayer when the layer being
//  cloned is a broadcast layer.

debugParsing = true;

HyPerCol "column" = {
   nx = 16;
   ny = 16;
   nbatch = 1;
   stopTime = 10.0;
   dt = 1.0;
   randomSeed = 1234567890;
   progressInterval = 1.0;
   writeProgressToErr = false;
   outputPath = "output/";
   verifyWrites = true;
   printParamsFilename = "pv.params";
   checkpointWrite = false;
   initializeFromCheckpointDir = "";
   lastCheckpointDir = "output/Last";
   errorOnNotANumber = false;
};

//
// layers
//

PvpLayer "Input" = {
    nxScale = 1;
    nyScale = 1;

    inputPath = "input/sampledata.pvp";
    nf = 1;
    phase = 0;
    writeStep = -1;
    updateGpu = false;
    mirrorBCflag = false;
    valueBC = 0.0;
    useInputBCflag = false;
    padValue = 0;
    inverseFlag = false;
    normalizeLuminanceFlag = false;
    autoResizeFlag = false;
    offsetAnchor = "tl";
    offsetX = 0;
    offsetY = 0;
    displayPeriod = 0;
};

HyPerLayer "Output" = {
    broadcastFlag = true;
    nf = 64;
    phase = 1;
    triggerLayerName = NULL;
    writeStep = 1.0;
    initialWriteTime = 0.0;
    mirrorBCflag = 1;
    sparseLayer = false;
    updateGpu = false;

    InitVType = "ZeroV";
};

CloneVLayer "Clone" = {
    phase = 2;
    triggerLayerName = NULL;
    writeStep = 1.0;
    initialWriteTime = 0.0;
    mirrorBCflag = 1;
    sparseLayer = false;
    updateGpu = false;

    originalLayerName = "Output";
};

HyPerLayer "Comparison" = {
    broadcastFlag = true;
    nf = 64;
    phase = 3;
    triggerLayerName = NULL;
    writeStep = 1.0;
    initialWriteTime = 0.0;
    mirrorBCflag = 1;
    sparseLayer = false;
    updateGpu = false;

    InitVType = "ZeroV";
};

//
// connections
//

HyPerConn "InputToOutput" = {
    preLayerName = "Input";
    postLayerName = "Output";
    nxp = 1;
    nyp = 1;
    channelCode = 0;
    sharedWeights = false;
    plasticityFlag = false;

    numAxonalArbors = 1;
    writeStep = -1;

    weightInitType = "UniformRandomWeight";
    wMinInit = 1.0;
    wMaxInit = 1.0;
    sparseFraction = 0.5;

    normalizeMethod = "none";

    delay = 0;

    pvpatchAccumulateType = "Convolve";
    updateGSynFromPostPerspective = false;
};

IdentConn "OutputToComparison" = {
    channelCode = 0;
    delay = 0;
};

IdentConn "CloneToComparison" = {
    channelCode = 1;
    delay = 0;
};

RequireAllZeroActivityProbe "Probe" = {
    targetLayer = "Comparison";
    textOutputFlag = true;
    probeOutputFile = NULL;
    message = NULL;
    triggerLayerName = NULL;
    nnzThreshold = 0;
    exitOnFailure = true;
    immediateExitOnFailure = false;
};
