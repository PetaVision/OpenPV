// Creates functions updateMomentumLCAOnGPU and updateMomentumLCAOnCPU,
// that take the same argument list and use the same core code, except that
// one is run from the .cu file and the other is run from the .cpp file.
// The .cu file defines the preprocessor directive PV_RUN_ON_GPU before
// including this file; the and the .cpp file undefines it.

#include "utils/conversions.hpp"
#include <cmath>
#ifdef PV_RUN_ON_GPU
namespace PVCuda {
__global__ void updateMomentumLCAOnGPU
#else
namespace PV {
inline void updateMomentumLCAOnCPU
#endif // PV_RUN_ON_GPU
      (int const nbatch,
       long const numNeurons,
       int numChannels,
       int const *channelIndices,
       float const *channelCoeffs,
       int const nx,
       int const ny,
       int const nf,
       int const lt,
       int const rt,
       int const dn,
       int const up,
       bool const selfInteract,
       float const momentumRate,
       double const *dtAdapt,
       double const tau,
       float const *GSyn,
       float const *A,
       float *prevDrive,
       float *V) {
#ifdef PV_RUN_ON_GPU
   int index = (blockIdx.x * blockDim.x) + threadIdx.x;
   if (index < numNeurons * nbatch)
#else
#ifdef PV_USE_OPENMP_THREADS
#pragma omp parallel for schedule(static)
#endif
   for (long index = 0; index < numNeurons * nbatch; index++)
#endif // PV_RUN_ON_GPU
   {
      long b = index / numNeurons;
      long k = index % numNeurons;

      float accumulatedGSyn = 0.0f;
      for (int chIdx = 0; chIdx < numChannels; chIdx++) {
         int channel = channelIndices[chIdx];
         float gSynValue = GSyn[channel * numNeurons * nbatch + index];
         accumulatedGSyn += channelCoeffs[channel] * gSynValue;
      }

      float exp_tau          = static_cast<float>(std::exp(-dtAdapt[b] / (double)tau));
      float *VBatch          = &V[b * numNeurons];
      float *prevDriveBatch  = &prevDrive[b * numNeurons];
      // Activity is an extended buffer.
      long numExtended = (long)(nx + rt + lt) * (long)(ny + up + dn) * (long)nf;
      float const *ABatch = &A[b * numExtended];

      long kex           = kIndexExtended(k, nx, ny, nf, lt, rt, dn, up);
      float currentDrive = (1.0f - exp_tau) * (accumulatedGSyn + selfInteract * ABatch[kex]);
      // Accumulate into VBatch with decay and momentum
      VBatch[k] = exp_tau * VBatch[k] + currentDrive + momentumRate * prevDriveBatch[k];
      // Update momentum buffer
      prevDriveBatch[k] = currentDrive;
   }
}

} // namespace (PV or PVCuda)
